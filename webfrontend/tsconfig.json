{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "jest",
      "node",
      "@testing-library/jest-dom"
    ],
    "target": "ES2017"
  },
  "typedocOptions": {
    "entryPoints": [
      "src/app"
    ],
    "out": "docs"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "jest.config.js",
    "__tests__/layout.test.jsx",
    "__tests__/assetdistribution.test.jsx"
, "__tests__/bar-charts.test.jsx", "__tests__/bar-charts.test.jsx", "__tests__/bar-charts.test.jsx", "__tests__/__data-fetching__/client-hooks.test.jsx", "__tests__/prefetch-query-test.jsx", "src/app/api/logging/route.js", "src/app/api/logging/route.js"  ],
  "exclude": [
    "node_modules"
  ]
}
